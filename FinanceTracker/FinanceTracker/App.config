<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <add name="FinanceTracker" providerName="System.Data.SqlClient"
             connectionString="Data Source=localhost,1433;Initial Catalog=FinanceTracker;User ID=sa;Password=;Encrypt=True;TrustServerCertificate=True;Connect Timeout=5" />
    </connectionStrings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
