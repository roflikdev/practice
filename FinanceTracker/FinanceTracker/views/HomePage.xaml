<Page x:Class="FinanceTracker.views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои финансы" Loaded="Page_Loaded" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="14">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Мои финансы" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Текущий баланс" Foreground="#64748B"/>
                    <TextBlock x:Name="BalanceText" Text="—" FontSize="32" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Все доходы" Foreground="#64748B"/>
                    <TextBlock x:Name="IncomeText" Text="—" FontSize="20" Foreground="#15803D"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Все расходы" Foreground="#64748B"/>
                    <TextBlock x:Name="ExpenseText" Text="—" FontSize="20" Foreground="#B91C1C"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Новая запись" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Тип" Margin="0,0,0,5"/>
                        <ComboBox x:Name="TypeBox" SelectedIndex="0" Height="34" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Расход"/>
                            <ComboBoxItem Content="Доход"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Сумма, ₽" Margin="0,0,0,5"/>
                        <TextBox x:Name="AmountBox" MaxLength="13" Height="34"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Дата" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DateBox" Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Описание" Margin="0,0,0,5"/>
                        <TextBox x:Name="DescriptionBox" MaxLength="150" Height="34"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="AddButton" Content="Добавить запись" Click="Add_Click" HorizontalAlignment="Left"
                        Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click"/>
                <TextBlock Text="История операций" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F3"
                      Background="White" BorderBrush="#DEE3EA" RowHeight="38" ColumnHeaderHeight="34" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OperationDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="100"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Изменение, ₽" Binding="{Binding Amount, StringFormat={}{0:+0.00;-0.00;0.00}}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#15803D"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypeName}" Value="Расход">
                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#64748B"/>
    </Grid>
</Page>
