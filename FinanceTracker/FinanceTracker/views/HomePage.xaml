<Page x:Class="FinanceTracker.views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinanceTracker.views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid Background="#ffffff">
        <StackPanel>
            <DockPanel Margin="20px">
                <StackPanel>
                    <Label Content="Текущий баланс:" FontSize="10px" FontWeight="SemiBold"/>
                    <Label Content="100$" FontSize="24px" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Page>
